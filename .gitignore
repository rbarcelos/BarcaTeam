# Copilot — user-local settings (machine-specific, never commit)
.copilot/settings.local.json

# Scheduled-task lock (runtime state — stale locks from dead sessions crash future ones)
.copilot/scheduled_tasks.lock

# Worktrees (machine-local, generated by lead agent)
.worktrees/

# VS Code
.vscode/
*.code-workspace

# DB files
*.db
*.db-shm
*.db-wal

# Test artifacts
test-results/
test_report.html

# Scratch / temp directory
.tmp/

# Screenshots and E2E artifacts
screenshots/
*.png
reviews/

# Runtime caches and logs (generated by target-product agent runs — never commit)
.cache/
cache/
logs/
.playwright-mcp/
